SHOPIFY_SHOP_DOMAIN=xxxx.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxx
SHOPIFY_API_SECRET=xxxx
# Dev DashboardのClient ID。埋め込み管理画面(api/admin-ui.ts)のApp Bridge初期化と
# セッショントークン検証(aud)に使用。秘密情報ではない(ブラウザにそのまま渡る)。
SHOPIFY_CLIENT_ID=xxxx
SHOPIFY_API_VERSION=2024-10
SHOPIFY_CURRENCY_CODE=JPY
# 「ガチャ景品」コレクションのハンドル(POST /api/admin/sync-prizes が使う)
SHOPIFY_GACHA_COLLECTION_HANDLE=gacha-prizes

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx

# 管理系エンドポイント(/api/admin/*)を叩くための共有シークレット
ADMIN_API_SECRET=xxxx

# 重大エラー(Webhook処理失敗・抽選処理失敗等)発生時のメール通知(任意設定)。
# いずれか未設定ならアラート送信自体をスキップする(lib/alertEmail.ts参照)。
# Gmailを使う場合はSMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=送信元アドレス,
# SMTP_PASS=Googleアカウントで発行したアプリパスワード(通常のログインパスワードは使えない)。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxxx@gmail.com
SMTP_PASS=xxxx
ALERT_EMAIL_TO=xxxx@example.com
# 省略時はSMTP_USERを送信元として使う
ALERT_EMAIL_FROM=xxxx@gmail.com
